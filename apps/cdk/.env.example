# Copy to .env.local (gitignored), which the cdk:* scripts load. Every variable the CDK app reads (see src/environment/variables.ts). Blank means unset.

# Required. Twelve digits.
AWS_ACCOUNT_ID=

# Optional; the defaults are shown.
AWS_REGION=us-east-1
DEPLOYMENT_STAGE=prod
DOMAIN_NAME=agents.gavindhondt.com
HOSTED_ZONE_NAME=gavindhondt.com
