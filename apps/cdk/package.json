{
    "name": "@agents/cdk",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm exec tsc",
        "lint": "pnpm exec eslint --cache --cache-location .cache/eslint . --fix",
        "lint:check": "pnpm exec eslint --cache --cache-location .cache/eslint-check . --max-warnings=0",
        "prettier": "pnpm exec prettier --cache --cache-location .cache/prettier --ignore-path ../../.prettierignore . --write",
        "clean": "rm -rf dist .turbo .cache cdk.out",
        "fullclean": "pnpm run clean && rm -rf node_modules",
        "test": "pnpm exec vitest run",
        "synth": "dotenv --override --no-expand -e .env -- pnpm exec cdk synth",
        "diff": "dotenv --override --no-expand -e .env -- pnpm exec cdk diff",
        "deploy": "dotenv --override --no-expand -e .env -- pnpm exec cdk deploy --all",
        "bootstrap": "dotenv --override --no-expand -e .env -- pnpm exec cdk bootstrap",
        "check-types": "pnpm exec tsc --noEmit"
    },
    "prettier": "@agents/prettier",
    "dependencies": {
        "aws-cdk-lib": "catalog:",
        "constructs": "catalog:"
    },
    "devDependencies": {
        "@agents/eslint": "workspace:*",
        "@agents/prettier": "workspace:*",
        "@agents/typescript": "workspace:*",
        "@types/node": "catalog:",
        "aws-cdk": "catalog:",
        "dotenv-cli": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
