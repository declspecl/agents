{
    "name": "@agents/api",
    "private": true,
    "scripts": {
        "dev": "cargo run",
        "test": "cargo test",
        "check-types": "cargo check --all-targets",
        "lint": "cargo clippy --all-targets --fix --allow-dirty --allow-staged -- -D warnings && cargo fmt",
        "lint:check": "cargo clippy --all-targets -- -D warnings && cargo fmt --check",
        "prettier": "cargo fmt",
        "clean": "cargo clean && rm -rf .turbo",
        "fullclean": "pnpm run clean"
    }
}
